# NOMU SECURE UPLOAD STORAGE
# Disable script engines & direct execution of scripts in this directory
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|bash)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

Options -ExecCGI -Indexes
SetHandler default-handler
